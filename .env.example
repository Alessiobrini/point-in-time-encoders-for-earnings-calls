# Copy to .env, edit, then `source .env` before running the pipeline.
export ECALLS_DATA_ROOT="$PWD/data"        # root of every data artifact
export ECALLS_ROOT="$PWD"                  # this repository on the cluster, read by cluster/*.sbatch
export ECALLS_PYTHON=python                # the environment's interpreter
export ECALLS_LLM_CACHE="$PWD/.llm-cache"  # ChronoGPT-Instruct downloads
# WRDS credentials are read from ~/.pgpass, not from here.
